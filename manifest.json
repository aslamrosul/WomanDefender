{
  "manifest_version": 3,
  "name": "WomanDefender AI - YouTube Modesty & Gaze Protection",
  "version": "1.1.0",
  "description": "Ekstensi 100% gratis & lokal untuk mendeteksi dan menutupi wanita, rambut terbuka, dan konten vulgar di YouTube.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WomanDefender AI",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.ytimg.com/*",
    "https://*.ggpht.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "libs/face-api.min.js",
        "scripts/vision-detector.js",
        "scripts/decision-engine.js",
        "scripts/content.js"
      ],
      "css": [
        "scripts/shield-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "models/*",
        "libs/*"
      ],
      "matches": [
        "https://*.youtube.com/*"
      ]
    }
  ]
}
